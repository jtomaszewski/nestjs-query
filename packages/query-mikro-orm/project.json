{
  "name": "query-mikro-orm",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "packages/query-mikro-orm/src",
  "projectType": "library",
  "tags": [],
  "targets": {
    "build": {
      "executor": "@nx/js:tsc",
      "outputs": ["{options.outputPath}"],
      "options": {
        "outputPath": "dist/packages/query-mikro-orm",
        "main": "packages/query-mikro-orm/src/index.ts",
        "tsConfig": "packages/query-mikro-orm/tsconfig.lib.json",
        "assets": ["packages/query-mikro-orm/*.md"]
      }
    },
    "publish": {
      "command": "node tools/scripts/publish.mjs query-mikro-orm {args.ver} {args.tag}",
      "dependsOn": ["build"]
    },
    "lint": {
      "executor": "@nx/eslint:lint",
      "outputs": ["{options.outputFile}"]
    },
    "test": {
      "executor": "@nx/jest:jest",
      "outputs": ["{workspaceRoot}/coverage/{projectRoot}"],
      "options": {
        "jestConfig": "packages/query-mikro-orm/jest.config.ts"
      }
    }
  }
}